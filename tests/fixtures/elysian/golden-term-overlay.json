[{"text": "终末余音", "box": [212, 313, 100, 28]}, {"text": "状态：「黄金」核心刻印提供的强化状态，每具有10点能量上限，每秒提高0.4%全伤害（上限为", "box": [213, 354, 847, 27]}, {"text": "160%）并扣除与当前持续时间相同的充能", "box": [216, 382, 368, 19]}, {"text": "请选择英桀的刻印", "box": [508, 140, 193, 26]}, {"text": "「黄金」的刻印", "box": [520, 96, 240, 37]}, {"text": "黄金的咏叹", "box": [636, 195, 144, 32]}, {"text": "每累计回复一定能量后攻击命中敌人时会对随机敌人释放咏叹的雷", "box": [637, 228, 583, 23]}, {"text": "鸣并施加沉醉状态。处于沉醉状态下的敌人受到的全伤害提高。若", "box": [638, 255, 582, 22]}, {"text": "角色具有【麻痹】特性，则释放咏叹的雷鸣后，将获得元素穿透", "box": [638, 281, 562, 23]}, {"text": "的充能，充能数不足时重置并结束终末余音状态", "box": [638, 434, 422, 22]}, {"text": "每具有10点能量上限，", "box": [641, 408, 196, 19]}, {"text": "三当前刻印", "box": [806, 656, 143, 28]}, {"text": "终末余音状态并增加充能。", "box": [817, 383, 241, 19]}, {"text": "每秒提高全伤害并扣除与当前持续时间相同", "box": [832, 407, 386, 23]}, {"text": "终末余音状态下", "box": [1053, 379, 153, 26]}, {"text": "简略", "box": [1149, 125, 45, 25]}, {"text": "核心", "box": [1186, 199, 35, 16]}, {"text": "核心", "box": [1186, 349, 36, 21]}, {"text": "V", "box": [1201, 119, 41, 42]}, {"text": "X", "box": [1216, 26, 38, 36]}]